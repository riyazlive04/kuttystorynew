# ---- Core ----
ENVIRONMENT=development

# ---- Datastores ----
DATABASE_URL=postgresql://kutty:kutty@localhost:5432/kuttystory
REDIS_URL=redis://localhost:6379/0

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:3000

# ---- Admin dashboard auth ----
ADMIN_TOKEN=

# ---- Razorpay (leave blank for mock-payment mode) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Private admin promo code. Collapses any cart to ADMIN_TEST_PROMO_TOTAL rupees
# so a real payment can be pushed through the LIVE gateway for pennies.
# Blank (the default) disables it entirely — an unset code behaves exactly like
# an invalid one, so it cannot be probed for. Server-side only: never mirror
# this into a NEXT_PUBLIC_* var or it ships in the JS bundle. Do not commit a
# real value.
ADMIN_TEST_PROMO_CODE=
ADMIN_TEST_PROMO_TOTAL=5

# ---- GPU provider: mock | runpod | replicate | comfyui ----
GPU_PROVIDER=mock

# RunPod Serverless (ComfyUI worker)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Replicate
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

# Self-hosted ComfyUI API node
COMFYUI_BASE_URL=
COMFYUI_API_KEY=

# ---- Book / render tuning ----
MOCK_RENDER_SECONDS=9
FREE_PREVIEW_PAGES=13
TOTAL_PAGES=28
DATA_RETENTION_HOURS=48

# --- Image personalization -------------------------------------------------
# Which service puts the child's face onto a page's base art is an ADMIN RUNTIME
# toggle (Admin -> Settings -> Image provider), stored in app_settings.json, not
# here. These are the tuning knobs for the OpenAI path.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# Paid/final render quality vs free-preview quality. Previews are rendered for
# every visitor, including those who never buy, so they default a tier down.
OPENAI_IMAGE_QUALITY=high
OPENAI_PREVIEW_QUALITY=low
OPENAI_INPUT_FIDELITY=high
OPENAI_CACHE_ENABLED=true

# Segmind (the default provider)
SEGMIND_API_KEY=
