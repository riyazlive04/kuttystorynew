# Point the frontend at the FastAPI backend. Leave unset to use the built-in
# mock data layer (fully client-side) so the app runs with zero backend.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin. Used for canonical tags, sitemap.xml, robots.txt
# and JSON-LD. Defaults to https://kuttystory.co.in.
# NEXT_PUBLIC_SITE_URL=https://kuttystory.co.in

# Google Tag Manager container. Production pins this in docker-compose.prod.yml;
# set it here only when you genuinely need to debug a tag locally, and remember
# that dev page views then land in the live container's data.
# NEXT_PUBLIC_GTM_ID=GTM-KGPJC2HG
